{
  "expo": {
    "name": "QR Pay Scanner",
    "slug": "qr-pay-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.qrpay.scanner",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "QR కోడ్ స్కాన్ చేయడానికి కెమెరా అనుమతి కావాలి"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "QR ఫోటో తీయడానికి కెమెరా అనుమతి కావాలి",
          "microphonePermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ]
  }
}
